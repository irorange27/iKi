{
  "name": "iki",
  "productName": "iki",
  "version": "0.1.1",
  "description": "A local agent pet for AI provider orchestration",
  "main": "packages/desktop/.vite/build/main.cjs",
  "scripts": {
    "vite:dev": "vite --config packages/desktop/vite.renderer.config.mjs",
    "vite:build": "vite build --config packages/desktop/vite.renderer.config.mjs",
    "vite:preview": "vite preview --config packages/desktop/vite.renderer.config.mjs",
    "app:dev": "cd packages/desktop && electron-forge start",
    "app:debug": "cd packages/desktop && electron-forge start -- --remote-debugging-port=9222",
    "app:build": "cd packages/desktop && electron-forge make",
    "app:preview": "node scripts/run-packaged-preview.cjs packages/desktop/out",
    "cdp": "node scripts/app_cdp.mjs",
    "elem-source": "node scripts/cdp_element_source.mjs",
    "benchmark:desktop-pet:system:summary": "node scripts/benchmarks/summarize-desktop-pet-system-eval.cjs",
    "changelog:scaffold": "node scripts/scaffold-changelog.cjs",
    "changelog:preview": "node scripts/scaffold-changelog.cjs --dry-run",
    "changelog:sync": "node scripts/scaffold-changelog.cjs --force",
    "changelog:check": "node scripts/scaffold-changelog.cjs --check",
    "ts": "tsc",
    "watch": "tsc -w",
    "start": "cd packages/desktop && electron-forge start",
    "package": "cd packages/desktop && electron-forge package",
    "make": "cd packages/desktop && electron-forge make",
    "publish": "cd packages/desktop && electron-forge publish",
    "lint": "eslint .",
    "lint:arch": "depcruise packages --config .dependency-cruiser.cjs",
    "knip": "knip --production",
    "arch:context": "node scripts/module_context.mjs",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css,scss,md,vue}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx,js,jsx,json,css,scss,md,vue}\"",
    "ts:vue": "vue-tsc --noEmit",
    "ci:quality": "pnpm run -s lint && pnpm run -s ts && pnpm run -s ts:vue && pnpm run -s lint:arch && pnpm run -s knip",
    "commit": "git-cz",
    "commit:check": "commitlint --from=HEAD~20 --to=HEAD --verbose",
    "prepare": "husky",
    "test:e2e": "pnpm run test:e2e:cli:faux && pnpm run test:e2e:desktop:faux",
    "test:e2e:cli:faux": "node tests/integration/e2e/run_cli_faux_e2e.mjs",
    "test:e2e:cli:live": "node tests/integration/e2e/run_live_api_e2e.mjs",
    "test:e2e:desktop:faux": "node tests/integration/e2e/run_provider_settings.mjs",
    "test:e2e:desktop:live": "node tests/integration/e2e/run_desktop_live_e2e.mjs",
    "test:e2e:live": "pnpm run test:e2e:cli:live && pnpm run test:e2e:desktop:live",
    "test:e2e:settings": "node tests/integration/e2e/run_provider_settings.mjs",
    "cli": "tsx packages/cli/src/main.ts"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irorange27/iKi.git"
  },
  "author": {
    "name": "irorange27",
    "email": "orange27@shu.edu.cn"
  },
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.4",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/shared-types": "^8.0.1",
    "@electron/rebuild": "^4.2.1",
    "@eslint/js": "^9.39.5",
    "@lucide/vue": "^1.78.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.1",
    "@vue/compiler-sfc": "^3.5.46",
    "@vue/test-utils": "^2.6.0",
    "commitizen": "^4.3.2",
    "cz-git": "^1.14.0",
    "dependency-cruiser": "^18.8.0",
    "electron": "45.4.1",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "smol-toml": "^1.9.1",
    "source-map-js": "^1.2.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "^1.6.0",
    "@iki/harness": "workspace:*",
    "@iki/theme": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@tailwindcss/vite": "^4.3.5",
    "ffmpeg-static": "^5.3.0",
    "gpt-tokenizer": "^4.1.2",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vue": "^3.5.46",
    "vue-markdown-render": "^3.0.0",
    "whisper-node": "^1.1.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
