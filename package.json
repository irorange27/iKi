{
  "name": "iki",
  "productName": "iki",
  "version": "0.0.1",
  "description": "A local agent pet for AI provider orchestration",
  "main": ".vite/build/main.js",
  "scripts": {
    "vite:dev": "vite --config vite.renderer.config.mjs",
    "vite:build": "vite build --config vite.renderer.config.mjs",
    "vite:preview": "vite preview --config vite.renderer.config.mjs",
    "app:dev": "tsc && concurrently \"npm run vite:dev\" \"electron .\" \"tsc -w\"",
    "app:build": "npm run vite:build && tsc && electron-builder",
    "app:preview": "npm run vite:build && tsc && electron .",
    "daemon:start": "tsc && node dist/daemon/index.js",
    "ts": "tsc",
    "watch": "tsc -w",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md,vue}\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": {
    "name": "irorange27",
    "email": "orange27@shu.edu.cn"
  },
  "license": "MIT",
  "devDependencies": {
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-deb": "^7.10.2",
    "@electron-forge/maker-rpm": "^7.10.2",
    "@electron-forge/maker-squirrel": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@iconify/json": "^2.2.427",
    "@lobehub/icons": "^4.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^9.2.1",
    "electron": "39.2.7",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "lucide-vue-next": "^0.562.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "unplugin-icons": "^22.5.0",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@ai-sdk-tool/parser": "^3.1.0",
    "@ai-sdk/deepseek": "^2.0.1",
    "@ai-sdk/openai": "^3.0.2",
    "@ai-sdk/openai-compatible": "^2.0.1",
    "@ai-sdk/vue": "^3.0.3",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@tailwindcss/vite": "^4.1.18",
    "ai": "^6.0.3",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.2.0",
    "highlight.js": "^11.11.1",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vue-markdown-render": "^2.3.0",
    "whisper-node": "^1.1.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^4.2.1",
    "zod-to-json-schema": "^3.25.1"
  }
}
