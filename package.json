{
  "name": "iki",
  "productName": "iki",
  "version": "0.0.2",
  "description": "A local agent pet for AI provider orchestration",
  "main": ".vite/build/main.js",
  "scripts": {
    "vite:dev": "vite --config vite.renderer.config.mjs",
    "vite:build": "vite build --config vite.renderer.config.mjs",
    "vite:preview": "vite preview --config vite.renderer.config.mjs",
    "app:dev": "electron-forge start",
    "app:build": "electron-forge make",
    "app:preview": "node scripts/run-packaged-preview.cjs",
    "benchmark:daemon": "node scripts/benchmarks/run-daemon-benchmark.cjs",
    "benchmark:affect": "node scripts/benchmarks/run-affect-benchmark.cjs",
    "benchmark:desktop-pet:system:summary": "node scripts/benchmarks/summarize-desktop-pet-system-eval.cjs",
    "benchmark:affect:thesis:run": "node scripts/benchmarks/run-affect-thesis-matrix.cjs",
    "benchmark:affect:thesis:summary": "node scripts/benchmarks/summarize-affect-thesis-results.cjs",
    "benchmark:affect:thesis:v2:scaffold": "node scripts/benchmarks/scaffold-affect-thesis-v2-manifest.cjs",
    "benchmark:affect:thesis:v2:append": "node scripts/benchmarks/append-affect-thesis-v2-manifest-supplement.cjs",
    "benchmark:affect:thesis:v2:packets": "node scripts/benchmarks/build-affect-thesis-v2-prompt-packets.cjs",
    "benchmark:affect:thesis:v2:ingest": "node scripts/benchmarks/ingest-affect-thesis-v2-candidate-batches.cjs",
    "benchmark:affect:thesis:v2:audit": "node scripts/benchmarks/audit-affect-thesis-v2-candidates.cjs",
    "benchmark:affect:thesis:v2:select": "node scripts/benchmarks/backfill-affect-thesis-v2-manifest-selections.cjs",
    "benchmark:affect:thesis:v2:prepare-annotation": "node scripts/benchmarks/scaffold-affect-thesis-v2-annotation-round.cjs",
    "benchmark:affect:thesis:v2:export-annotation-sheets": "node scripts/benchmarks/export-affect-thesis-v2-annotation-sheets.cjs",
    "benchmark:affect:thesis:v2:import-annotation-sheet": "node scripts/benchmarks/import-affect-thesis-v2-annotation-sheet.cjs",
    "benchmark:affect:thesis:v2:backfill": "node scripts/benchmarks/backfill-affect-thesis-v2-manifest-labels.cjs",
    "benchmark:affect:thesis:v2:freeze": "node scripts/benchmarks/freeze-affect-thesis-v2-dataset.cjs",
    "benchmark:affect:thesis:v3:matrix": "node scripts/benchmarks/run-v3-behavioral-matrix.cjs",
    "benchmark:affect:thesis:v3:blind:prepare": "node scripts/benchmarks/prepare-v3-blind-evaluation.cjs",
    "benchmark:affect:thesis:v3:blind:analyze": "node scripts/benchmarks/analyze-v3-blind-results.cjs",
    "benchmark:affect:thesis:v3:generate": "node scripts/benchmarks/generate-v3-scenarios.cjs",
    "daemon:start": "tsc && node scripts/start-daemon.cjs",
    "changelog:scaffold": "node scripts/scaffold-changelog.cjs",
    "changelog:preview": "node scripts/scaffold-changelog.cjs --dry-run",
    "changelog:sync": "node scripts/scaffold-changelog.cjs --force",
    "changelog:check": "node scripts/scaffold-changelog.cjs --check",
    "ts": "tsc",
    "watch": "tsc -w",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "lint": "eslint --ext .ts,.tsx,.vue .",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md,vue}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md,vue}\"",
    "test": "vitest run",
    "test:smoke:memory": "vitest run --run tests/core/memory/embedding.test.ts tests/core/memory/memory_db_crud.test.ts tests/core/memory/memory_search_embeddings.test.ts tests/core/memory/auto_summarize.test.ts tests/core/runtimes/memory_retrieval_runtime.test.ts tests/renderer/components/SettingsMemorySection.test.ts tests/main/chat_memory_scope.test.ts tests/main/services/chat/chat_context.test.ts tests/main/services/chat/chat_streaming.test.ts tests/main/services/chat/chat_approval.test.ts tests/main/ipc/data_access_modules.test.ts tests/daemon/server.test.ts tests/main/services/life/life_reflection.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:renderer": "vitest run tests/renderer",
    "test:watch": "vitest",
    "ts:vue": "vue-tsc --noEmit",
    "ci:quality": "pnpm run -s lint && pnpm run -s ts && pnpm run -s ts:vue && pnpm run -s test:coverage",
    "commit": "git-cz",
    "commit:check": "commitlint --from=HEAD~20 --to=HEAD --verbose",
    "prepare": "husky"
  },
  "keywords": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irorange27/iKi.git"
  },
  "author": {
    "name": "irorange27",
    "email": "orange27@shu.edu.cn"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@electron-forge/cli": "^7.8.3",
    "@electron-forge/maker-dmg": "^7.10.2",
    "@electron-forge/maker-zip": "^7.10.2",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.2",
    "@electron-forge/plugin-fuses": "^7.10.2",
    "@electron-forge/plugin-vite": "^7.10.2",
    "@electron/fuses": "^1.8.0",
    "@iconify/json": "^2.2.427",
    "@types/better-sqlite3": "^7.6.13",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.0",
    "@vue/test-utils": "^2.4.6",
    "commitizen": "^4.2.4",
    "concurrently": "^9.2.1",
    "cz-git": "^1.12.0",
    "electron": "39.2.7",
    "eslint": "^8.57.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-vue": "^9.33.0",
    "happy-dom": "^20.8.4",
    "husky": "^9.1.7",
    "lucide-vue-next": "^0.562.0",
    "prettier": "^3.7.4",
    "typescript": "^5.8.3",
    "unplugin-icons": "^22.5.0",
    "vite": "^6.4.1",
    "vitest": "^4.1.0",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^0.18.2",
    "@ai-sdk-tool/parser": "^3.1.0",
    "@ai-sdk/anthropic": "^3.0.64",
    "@ai-sdk/deepseek": "^2.0.1",
    "@ai-sdk/openai": "^3.0.2",
    "@ai-sdk/openai-compatible": "^2.0.1",
    "@ai-sdk/vue": "^3.0.3",
    "@mcpc-tech/acp-ai-provider": "^0.3.2",
    "@modelcontextprotocol/sdk": "^1.25.1",
    "@tailwindcss/vite": "^4.1.18",
    "ai": "^6.0.3",
    "better-sqlite3": "^12.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.5.0",
    "electron-squirrel-startup": "^1.0.1",
    "ffmpeg-static": "^5.2.0",
    "gpt-tokenizer": "^3.4.0",
    "highlight.js": "^11.11.1",
    "pinia": "^3.0.4",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "vercel-minimax-ai-provider": "^0.0.2",
    "vue": "^3.5.30",
    "vue-markdown-render": "^2.3.0",
    "whisper-node": "^1.1.0",
    "winston": "^3.19.0",
    "ws": "^8.19.0",
    "zod": "^4.2.1"
  },
  "config": {
    "commitizen": {
      "path": "cz-git"
    }
  }
}
