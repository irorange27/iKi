{
  "compilerOptions": {
    "composite": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "paths": {
      "@iki/harness/*": [
        "../harness/src/*"
      ],
      "@iki/core/*": [
        "../core/src/*"
      ],
      "@iki/store/*": [
        "../store/src/*"
      ],
      "@iki/session/*": [
        "../session/src/*"
      ],
      "@iki/llm/*": [
        "../llm/src/*"
      ],
      "@iki/llm-pi-ai/*": [
        "../llm-pi-ai/src/*"
      ],
      "@iki/agent": [
        "../agent/src/index.ts"
      ],
      "@iki/agent/*": [
        "../agent/src/*"
      ],
      "@iki/agent-loop": [
        "../agent-loop/src/index.ts"
      ],
      "@iki/agent-loop/*": [
        "../agent-loop/src/*"
      ]
    },
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": [
    "src/**/*.ts"
  ]
}
