{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@iki/theme": [
        "./packages/theme/src/index.ts"
      ],
      "@iki/theme/*": [
        "./packages/theme/src/*"
      ],
      "@iki/backend/*": [
        "./packages/backend/src/*"
      ],
      "@iki/core/*": [
        "./packages/core/src/*"
      ],
      "@iki/store/*": [
        "./packages/store/src/*"
      ],
      "@iki/ai/*": [
        "./packages/ai/src/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./packages/desktop/src/renderer/types"
    ]
  },
  "include": [
    "packages/desktop/src/**/*",
    "packages/backend/src/**/*",
    "packages/core/src/**/*",
    "packages/store/src/**/*",
    "packages/ai/src/**/*"
  ]
}
