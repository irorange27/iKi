{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@iki/theme": [
        "./packages/theme/src/index.ts"
      ],
      "@iki/theme/*": [
        "./packages/theme/src/*"
      ],
      "@iki/harness/*": [
        "./packages/harness/src/*"
      ],
      "@iki/core/*": [
        "./packages/core/src/*"
      ],
      "@iki/store/*": [
        "./packages/store/src/*"
      ],
      "@iki/session/*": [
        "./packages/session/src/*"
      ],
      "@iki/llm/*": [
        "./packages/llm/src/*"
      ],
      "@iki/llm-pi-ai/*": [
        "./packages/llm-pi-ai/src/*"
      ],
      "@iki/agent": [
        "./packages/agent/src/index.ts"
      ],
      "@iki/agent/*": [
        "./packages/agent/src/*"
      ],
      "@iki/agent-loop": [
        "./packages/agent-loop/src/index.ts"
      ],
      "@iki/agent-loop/*": [
        "./packages/agent-loop/src/*"
      ],
      "@iki/system-prompt": [
        "./packages/system-prompt/src/index.ts"
      ],
      "@iki/system-prompt/*": [
        "./packages/system-prompt/src/*"
      ],
      "@iki/tools": [
        "./packages/tools/src/index.ts"
      ],
      "@iki/tools/shell": [
        "./packages/tools/src/shell/index.ts"
      ],
      "@iki/tools/swarm": [
        "./packages/tools/src/swarm/index.ts"
      ],
      "@iki/tools/ptc": [
        "./packages/tools/src/ptc/index.ts"
      ],
      "@iki/tools/*": [
        "./packages/tools/src/*"
      ]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./packages/desktop/src/renderer/types"
    ]
  },
  "include": [
    "packages/desktop/src/**/*",
    "packages/harness/src/**/*",
    "packages/core/src/**/*",
    "packages/store/src/**/*",
    "packages/session/src/**/*",
    "packages/llm/src/**/*",
    "packages/llm-pi-ai/src/**/*",
    "packages/agent/src/**/*",
    "packages/agent-loop/src/**/*",
    "packages/system-prompt/src/**/*",
    "packages/tools/src/**/*",
    "packages/cli/src/**/*"
  ]
}
