{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "sourceMap": true,
    "outDir": "dist",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@iki/daemon": ["./packages/daemon/src/index.ts"],
      "@iki/daemon/*": ["./packages/daemon/src/*"],
      "@iki/theme": ["./packages/theme/src/index.ts"],
      "@iki/theme/*": ["./packages/theme/src/*"],
      "@iki/backend": ["./packages/backend/src/index.ts"],
      "@iki/backend/*": ["./packages/backend/src/*"]
    },
    "typeRoots": [
      "./node_modules/@types",
      "./packages/desktop/src/renderer/types"
    ]
  },
  "include": [
    "packages/daemon/src/**/*",
    "packages/desktop/src/**/*"
  ]
}
