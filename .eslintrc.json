{
  "env": {
    "browser": true,
    "es6": true,
    "node": true
  },
  "extends": [
    "eslint:recommended",
    "plugin:@typescript-eslint/eslint-recommended",
    "plugin:@typescript-eslint/recommended",
    "plugin:import/recommended",
    "plugin:import/electron",
    "plugin:import/typescript"
  ],
  "parser": "@typescript-eslint/parser",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "settings": {
    "import/resolver": {
      "typescript": {
        "alwaysTryTypes": true,
        "project": [
          "tsconfig.json",
          "packages/*/tsconfig.json"
        ]
      }
    }
  },
  "overrides": [
    {
      "files": [
        "*.vue"
      ],
      "parser": "vue-eslint-parser",
      "parserOptions": {
        "parser": "@typescript-eslint/parser",
        "extraFileExtensions": [
          ".vue"
        ],
        "ecmaVersion": "latest",
        "sourceType": "module"
      },
      "plugins": [
        "vue"
      ],
      "rules": {
        "vue/no-parsing-error": "error"
      }
    },
    {
      "files": [
        "packages/*/src/**/*.ts",
        "packages/*/src/**/*.vue"
      ],
      "excludedFiles": [
        "**/i18n/catalogs/**"
      ],
      "rules": {
        "max-lines": [
          "error",
          {
            "max": 800,
            "skipBlankLines": false,
            "skipComments": false
          }
        ]
      }
    },
    {
      "files": [
        "packages/backend/src/agent/runners/pi_tool_turn_harness.ts",
        "packages/desktop/src/renderer/components/ChatInput.vue",
        "packages/desktop/src/renderer/components/Sidebar.vue",
        "packages/desktop/src/renderer/components/chat/ChatMessageParts.vue",
        "packages/desktop/src/renderer/components/ChatModelSelector.vue",
        "packages/desktop/src/renderer/store/thread_session.ts",
        "packages/desktop/src/renderer/views/ChatView.vue"
      ],
      "rules": {
        "max-lines": "off"
      }
    }
  ],
  "ignorePatterns": [
    "docs/",
    "out/",
    "node_modules/"
  ]
}
