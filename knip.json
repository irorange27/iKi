{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": [
    "-lintignore"
  ],
  "ignoreBinaries": [
    "ffmpeg",
    "pgrep",
    "electron-forge"
  ],
  "ignoreDependencies": [
    "tailwindcss",
    "tw-animate-css",
    "reka-ui",
    "vue-markdown-render",
    "highlight.js",
    "katex",
    "@iki/harness",
    "@iki/theme",
    "@tailwindcss/vite",
    "ffmpeg-static",
    "whisper-node"
  ],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.{mjs,cjs,ts}",
        "site/src/main.ts"
      ],
      "project": [
        "scripts/**/*.{mjs,cjs,ts}",
        "site/src/**/*.{ts,vue}"
      ]
    },
    "packages/harness": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/cli": {
      "entry": [
        "src/main.ts!"
      ],
      "project": [
        "src/**/*.ts!"
      ]
    },
    "packages/theme": {
      "project": [
        "src/**/*.ts"
      ]
    },
    "packages/desktop": {
      "entry": [
        "src/main.ts",
        "src/preload/index.ts",
        "src/renderer/index.ts",
        "forge.config.ts",
        "vite.main.config.ts",
        "vite.preload.config.ts",
        "vite.renderer.config.mjs"
      ],
      "project": [
        "src/**/*.{ts,vue}"
      ]
    }
  },
  "ignore": [
    "site/dist/**",
    "packages/cli/dist/**",
    "packages/desktop/.vite/**",
    "packages/desktop/out/**",
    "packages/desktop/dist/**"
  ]
}
